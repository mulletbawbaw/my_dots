# Itens que Enter NÃO executa (perigosos ou sem sentido fora do contexto)
NO_RUN = re.compile(r"^(killactive|submap|resizeactive|mouse )|dispatch exit|KillActiveProcess")

# Recursos que não são atalho de teclado: (categoria, onde, descrição, comando)
FEATURES = [
    ("Waybar", "Clique  󰊠 BB", "Menu de aplicativos", "rofi -show drun"),
    ("Waybar", "Direito 󰊠 BB", "Info do sistema (fastfetch)", "kitty --hold -e fastfetch"),
    ("Waybar", "Clique  󰌌", "Esta central de atalhos", ""),
    ("Waybar", "Clique  CPU / RAM", "Monitor de sistema (btop)", "kitty -e btop"),
    ("Waybar", "Clique  GPU", "Monitor da GPU (nvtop)", "kitty -e nvtop"),
