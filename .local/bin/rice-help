    ("Waybar", "Direito Volume", "Mixer (pavucontrol)", "pavucontrol"),
    ("Waybar", "Meio    Volume", "Equalizador (EasyEffects)", "easyeffects"),
    ("Waybar", "Scroll  Volume", "Ajustar volume", ""),
    ("Waybar", "Clique  Mic", "Mutar microfone", "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"),
    ("Waybar", "Clique  Player", "Play / pause (direito: próxima)", "playerctl play-pause"),
