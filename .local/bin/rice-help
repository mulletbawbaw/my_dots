    ("Waybar", "Clique  󰾪", "Impedir tela de dormir", ""),
    ("Waybar", "Clique  Sino", "Notificações (direito: não perturbe)", "swaync-client -t -sw"),
    ("Waybar", "Clique  ⏻", "Desligar / reiniciar / sair", "wlogout -b 5 -T 440 -B 440"),
    ("Terminal", "rice-theme", "Regenerar cores de tudo a partir de palette.json", ""),
    ("Terminal", "rice-wall", "Trocar wallpaper pelo terminal", ""),
    ("Terminal", "rice-gaming on|off", "Modo jogo", ""),
    ("Terminal", "rice-kde", "Sincronizar tema com KDE/Qt/GTK", ""),
    ("Terminal", "gamemoderun %command%", "Na Steam: ativa GameMode por jogo", ""),
    ("Arquivos", "~/Pictures/Screenshots", "Pasta dos prints", "xdg-open " + HOME + "/Pictures/Screenshots"),
    ("Arquivos", "~/my_dots", "Dotfiles (git + stow)", "thunar " + HOME + "/my_dots"),
]

ICONS = {
    "Print": "󰹑", "Apps": "󰀻", "Janelas": "󰖲", "Workspaces": "󰕰", "Mídia": "󰝚",
    "Visual": "󰏘", "Sistema": "󰒓", "Waybar": "󰍜", "Terminal": "󰆍", "Arquivos": "󰉋", "Outros": "󰘳",
}
ORDER = list(ICONS)


def keyname(b):
    k = b["key"] or KEYCODES.get(b["keycode"], f"code:{b['keycode']}")
    k = KEYNAMES.get(k.lower(), k)
    if len(k) == 1:
        k = k.upper()
    elif k.lower().startswith("xf86"):
        k = k[4:]
    mods = [n for m, n in MODS if b["modmask"] & m]
    return " + ".join(mods + [k])


def exists(arg):
    """False se o primeiro executável do comando não existe (ex.: asusctl num desktop)."""
    first = arg.split()[0] if arg.split() else ""
    return bool(first) and (shutil.which(first) or os.path.exists(first))


def describe(b):
    line = f"{b['dispatcher']} {b['arg']}".strip()
    for cat, rx, text in DESCR:
        m = re.search(rx, line)
        if m:
            n = m.group(1) if m.groups() and m.group(1) and m.group(1).isdigit() else ""
            return cat, text.format(arg=b["arg"], n=n)
    if b.get("description"):
        return "Outros", b["description"]
    short = re.sub(re.escape(HOME) + r"/\.config/hypr/(User)?[Ss]cripts/", "", line)
    return "Outros", short[:60]


def collect():
    binds = json.loads(subprocess.run(["hyprctl", "binds", "-j"], capture_output=True, text=True).stdout or "[]")
    rows, seen = [], set()
    for b in binds:
        if b["dispatcher"] == "exec" and not exists(b["arg"]):
            continue
        keys = keyname(b)
        cat, text = describe(b)
        if b["submap"]:
            keys = f"[{b['submap']}] {keys}"
        if (keys, text) in seen:
            continue
        seen.add((keys, text))
        cmd = "" if NO_RUN.search(f"{b['dispatcher']} {b['arg']}") else f"{b['dispatcher']}\t{b['arg']}"
        rows.append((cat, keys, text, cmd))
    for cat, where, text, cmd in FEATURES:
        rows.append((cat, where, text, f"exec\t{cmd}" if cmd else ""))
    rows.sort(key=lambda r: (ORDER.index(r[0]) if r[0] in ORDER else 99))
    return rows


def esc(s):
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def main():
    rows = collect()
    width = max(len(r[1]) for r in rows) + 2
    if "--list" in sys.argv:
        for cat, keys, text, _ in rows:
            print(f"{cat:<11} {keys:<{width}} {text}")
        return
    lines = [
        f"<span foreground='#8c8c9c'>{ICONS.get(cat, '•')} {cat:<10}</span> "
        f"<b>{esc(keys):<{width}}</b> {esc(text)}"
        for cat, keys, text, _ in rows
    ]
    if subprocess.run(["pidof", "rofi"], capture_output=True).returncode == 0:
        subprocess.run(["pkill", "-x", "rofi"])
        return
    res = subprocess.run(
        ["rofi", "-dmenu", "-i", "-markup-rows", "-format", "i", "-p", "󰌌",
         "-theme", THEME, "-mesg",
         "↵ executa o item  ·  ⎋ fecha  ·  busque por tecla, nome ou categoria (ex.: print, workspace, waybar)"],
        input="\n".join(lines), capture_output=True, text=True,
    )
    if res.returncode != 0 or not res.stdout.strip():
        return
    cmd = rows[int(res.stdout.strip())][3]
    if not cmd:
        return
    dispatcher, arg = cmd.split("\t", 1)
    if dispatcher == "exec":
        subprocess.Popen(["hyprctl", "dispatch", "exec", arg], stdout=subprocess.DEVNULL)
    else:
        subprocess.Popen(["hyprctl", "dispatch", dispatcher, arg], stdout=subprocess.DEVNULL)


if __name__ == "__main__":
    main()
