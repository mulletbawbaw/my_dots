{
  "positionX": "right",
  "positionY": "top",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 10,
  "control-center-margin-right": 8,
  "notification-icon-size": 64,
  "notification-body-image-height": 80,
  "notification-body-image-width": 160,
  "timeout": 10,
  "timeout-low": 5,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "control-center-width": 420,
  "control-center-height": 0,
  "notification-window-width": 520,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 140,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "text-empty": "nada por aqui... ainda.",
  "widgets": [
    "label",
    "title",
    "dnd",
    "mpris",
    "volume",
    "buttons-grid",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notificações",
      "clear-all-button": true,
      "button-text": "󰩺 limpar"
    },
    "dnd": {
      "text": "Não perturbe"
    },
    "label": {
      "max-lines": 1,
      "text": "󰊠 MULLETBAWBAW // INBOX"
    },
    "mpris": {
      "image-size": 72,
      "image-radius": 6,
      "blacklist": [
        "kew",
        "firefox"
      ]
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true,
      "show-per-app-label": false
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰐥",
          "command": "sh -c 'swaync-client -cp; wlogout -b 5 -T 440 -B 440'"
        },
        {
          "label": "󰊗",
          "command": "sh -c 'swaync-client -cp; $HOME/.local/bin/rice-gaming toggle'"
        },
        {
          "label": "󰝟",
          "command": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
          "type": "toggle",
          "update-command": "sh -c 'wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && echo true || echo false'"
        },
        {
          "label": "󰍭",
          "command": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
          "type": "toggle",
          "update-command": "sh -c 'wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED && echo true || echo false'"
        },
        {
          "label": "󰂯",
          "command": "sh -c 'swaync-client -cp; blueman-manager'"
        },
        {
          "label": "󰄄",
          "command": "sh -c 'swaync-client -cp; sleep .3; $HOME/.config/hypr/scripts/ScreenShot.sh --swappy'"
        }
      ]
    }
  }
}
