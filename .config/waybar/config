// ── MulletBawbaw // waybar ───────────────────────────────────────────
// Duas barras: P1 (Odyssey, HUD completa) e P2 (secundário, enxuta).
// Módulos compartilhados ficam em mulletbawbaw.modules.jsonc.
// Config antiga (gruvbox): git show main:.config/waybar/config
[
  {
    "name": "p1",
    "output": "DP-1",
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "include": ["~/.config/waybar/mulletbawbaw.modules.jsonc"],
    "modules-left": ["custom/bb", "custom/help", "hyprland/workspaces", "hyprland/submap", "hyprland/window"],
    "modules-center": ["clock", "custom/gaming"],
    "modules-right": [
      "mpris",
      "cpu", "memory", "group/sensors",
      "custom/docker",
      "wireplumber", "wireplumber#mic",
      "bluetooth", "network",
      "tray", "idle_inhibitor", "custom/swaync", "custom/power"
    ]
  },
  {
    "name": "p2",
    "output": "!DP-1",
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "include": ["~/.config/waybar/mulletbawbaw.modules.jsonc"],
    "modules-left": ["custom/p2", "custom/help", "hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["mpris", "wireplumber", "custom/swaync"]
  }
]
