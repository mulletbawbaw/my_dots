configuration {
  modi: "run,drun,window";
  lines: 8;
  cycle: false;
  font: "JetbrainsMono Nerd Font Bold 10";
  show-icons: true;
  terminal: "kitty";
  drun-display-format: "{icon} {name}";
  location: 0;
  disable-history: true;
  hide-scrollbar: true;
  display-drun: "APPS";
  display-run: "RUN";
  display-window: "WINDOWS";
  sidebar-mode: true;
  sorting-method: "fzf";
}

/* Tema antigo (gruvbox): @theme "theme" */
@theme "~/.config/rofi/mulletbawbaw/theme.rasi"
/* Blocos de layout gruvbox removidos; ver `git show main:.config/rofi/config.rasi`. */
